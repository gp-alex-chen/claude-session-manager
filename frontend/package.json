{
  "name": "claude-terminal-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --outfile=dist/main.js --minify && node -e \"require('fs').copyFileSync('src/index.html','dist/index.html')\"",
    "watch": "esbuild src/main.js --bundle --outfile=dist/main.js --sourcemap --watch",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
